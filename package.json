{
  "name": "tab-sorter",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Private, window-scoped native tab groups for Chromium browsers",
  "license": "MIT",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm test && npm run build",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "fflate": "^0.8.2"
  },
  "engines": { "node": ">=22.12.0" }
}
